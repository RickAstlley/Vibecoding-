# Arcanum Weaver - configuracao para Apache (Hostinger)
# Coloque este arquivo na raiz do dominio (public_html/.htaccess)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # SPA: qualquer rota nao-fisica cai no index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]

  # Service Worker nunca deve ser cacheado
  RewriteRule ^sw\.js$ - [L]
</IfModule>

<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# Hashed assets: cache longo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compressao de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Seguranca basica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------- Runtime local
# O WebContainer (Node em WASM dentro da aba) exige SharedArrayBuffer, que so
# existe com isolamento de origem. Estes cabecalhos sao obrigatorios.
#
# ATENCAO: `require-corp` bloqueia recursos de terceiros sem CORP. As CDNs
# usadas pelo app (esm.sh, webcontainers.io) atendem, mas se voce apontar o
# preview para um asset externo sem CORP, ele nao carrega.
<IfModule mod_headers.c>
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "require-corp"
  Header set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# Se a API local de IA for usada junto com o runtime, libere COEP credencial.
# <IfModule mod_headers.c>
#   Header set Cross-Origin-Embedder-Policy "credentialless"
# </IfModule>